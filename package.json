{
  "name": "seahorse-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @seahorse/backend --filter @seahorse/frontend dev",
    "dev:frontend": "pnpm --filter @seahorse/frontend dev",
    "dev:backend": "pnpm --filter @seahorse/backend dev",
    "build": "pnpm --filter @seahorse/shared build && pnpm --filter @seahorse/backend build && pnpm --filter @seahorse/frontend build",
    "build:frontend": "pnpm --filter @seahorse/shared build && pnpm --filter @seahorse/frontend build",
    "build:backend": "pnpm --filter @seahorse/shared build && pnpm --filter @seahorse/backend build",
    "test": "pnpm --filter @seahorse/backend test && pnpm --filter @seahorse/frontend test:run",
    "test:backend": "pnpm --filter @seahorse/backend test",
    "test:frontend": "pnpm --filter @seahorse/frontend test:run",
    "lint": "eslint .",
    "arch:check": "depcruise apps/frontend/src apps/backend/src packages/shared/src --config .dependency-cruiser.cjs",
    "typecheck": "pnpm --filter @seahorse/shared typecheck && pnpm --filter @seahorse/backend typecheck && pnpm --filter @seahorse/frontend typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.5",
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
